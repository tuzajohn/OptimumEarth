@page
@model OptimumEarth.Web.Pages.IndexModel
@{
    ViewData["Theme"] = "home";
    ViewData["Title"] = "Water, Energy, Environment & GIS Engineering";
    ViewData["Description"] = "Optimum Earth delivers water, energy, environment, GIS and engineering solutions across East and Southern Africa, alongside the community-led Optimum Earth Foundation.";
}

<section class="hero-carousel" data-hero-carousel aria-roledescription="carousel" aria-label="Optimum Earth destinations">
    <a href="#who-we-are-heading" class="hero-carousel__who-btn btn btn--nav btn--ghost">Who We Are</a>

    @for (var i = 0; i < Model.HeroSlides.Count; i++)
    {
        var slide = Model.HeroSlides[i];
        <div class="hero-carousel__slide@(i == 0 ? " is-active" : "")" data-hero-slide="@i">
            <div class="img-slot" role="img" aria-label="@slide.ImageLabel" style="background-image: url('/img/optimum-earth-images/heroslide@(i + 1).jpg')"></div>
        </div>
    }
    <div class="hero-carousel__scrim" aria-hidden="true"></div>

    @for (var i = 0; i < Model.HeroSlides.Count; i++)
    {
        var slide = Model.HeroSlides[i];
        <div class="hero-carousel__copy" data-hero-copy="@i" hidden="@(i == 0 ? null : "hidden")">
            <span class="hero-carousel__eyebrow">@slide.Eyebrow</span>
            <h1 class="hero-carousel__headline">@slide.Headline</h1>
            <p class="hero-carousel__body">@slide.Body</p>
        </div>
    }

    @if (Model.HeroSlides.Count > 1)
    {
        <button type="button" class="hero-carousel__arrow hero-carousel__arrow--prev" data-hero-prev aria-label="Previous slide">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button type="button" class="hero-carousel__arrow hero-carousel__arrow--next" data-hero-next aria-label="Next slide">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
    }

    <div class="hero-carousel__row">
        <div class="hero-carousel__actions">
            <a href="/uganda" class="btn btn--lg btn--blue">Uganda</a>
            <a href="/zambia" class="btn btn--lg btn--grey">Zambia</a>
            <span class="hero-carousel__pip" aria-hidden="true"></span>
            <a href="/foundation" class="btn btn--lg btn--green">Foundation</a>
        </div>
    </div>
</section>

<section class="who-we-are" aria-labelledby="who-we-are-heading">
    <div class="who-we-are__rule-row">
        <span class="eyebrow" id="who-we-are-heading" style="letter-spacing:.2em;">Who we are</span>
        <span class="who-we-are__rule" aria-hidden="true"></span>
    </div>

    <div class="who-we-are__split">
        <h2 class="who-we-are__statement">Serving the East and Southern Africa water and energy industry since <em>2017</em>, across the full project lifecycle.</h2>
        <div class="who-we-are__support">
            <p class="who-we-are__lede">We support projects from first survey to commissioning, building the partnerships and delivering the infrastructure that meets environmental and quality standards.</p>
            <div class="stat-pair">
                <div class="stat"><b>100+</b><span>Organisations served</span></div>
                <div class="stat"><b>02</b><span>Country operations</span></div>
            </div>
        </div>
    </div>

    <div class="capability-grid">
        @foreach (var c in Model.Capabilities)
        {
            <div class="capability-cell">
                <span class="capability-cell__index">@c.Index</span>
                <span class="capability-cell__title">@c.Title</span>
                <span class="capability-cell__desc">@c.Description</span>
            </div>
        }
    </div>
</section>

<section class="service-sequence" aria-label="What we do across the region">
    <div class="service-sequence__intro">
        <span class="eyebrow" style="letter-spacing:.2em;">What we do across the region</span>
        <h2>Six service lines, one accountable technical team.</h2>
    </div>

    @for (var i = 0; i < Model.ServicePanels.Count; i++)
    {
        var panel = Model.ServicePanels[i];
        var sideClass = panel.Side == "left" ? "service-panel--left" : "service-panel--right";
        var scrimClass = panel.Scrim == "navy" ? "service-panel--navy" : "service-panel--white";
        var scrimDivClass = panel.Scrim == "navy"
            ? "service-panel__scrim service-panel__scrim--navy-left"
            : "service-panel__scrim service-panel__scrim--white-right";
        <div class="service-panel @sideClass @scrimClass" style="z-index:@(i + 1);">
            <div class="img-slot" role="img" aria-label="@panel.ImageLabel" style="background-image: url('/img/optimum-earth-images/servicepanel@(i + 1).jpg')"></div>
            <div class="@scrimDivClass" aria-hidden="true"></div>
            <div class="service-panel__copy-wrap">
                <div class="service-panel__copy">
                    <div class="service-panel__counter-row">
                        <span class="service-panel__counter">@panel.Counter</span>
                        <span class="service-panel__rule" aria-hidden="true"></span>
                    </div>
                    <span class="service-panel__eyebrow">@panel.Eyebrow</span>
                    <h3 class="service-panel__headline">@panel.Headline</h3>
                </div>
            </div>
        </div>
    }
</section>

<section class="evidence" aria-labelledby="evidence-heading">
    <div class="evidence__stats">
        <div class="evidence__stat"><b>2017</b><span>Serving the region since</span></div>
        <div class="evidence__stat"><b>100+</b><span>Organisations served</span></div>
        <div class="evidence__stat"><b>02</b><span>Country operations</span></div>
        <div class="evidence__stat"><b>06</b><span>Core service lines</span></div>
    </div>

    <div class="evidence__recent">
        <div class="evidence__recent-head">
            <div>
                <span class="eyebrow" style="letter-spacing:.2em;">Project evidence</span>
                <h2 id="evidence-heading">Recent work</h2>
            </div>
            <a class="text-link" href="/projects">All projects &rarr;</a>
        </div>
        <div class="card-grid">
            @for (var i = 0; i < Model.RecentWork.Count; i++)
            {
                var project = Model.RecentWork[i];
                <article class="project-card">
                    <div class="project-card__media img-slot" role="img" aria-label="@project.ImageLabel" style="background-image: url('/img/optimum-earth-images/recentwork@(i + 1).jpg')"></div>
                    <div class="project-card__body">
                        <span class="project-card__tag">@project.Tag</span>
                        <h3 class="project-card__title">@project.Title</h3>
                        <p class="project-card__meta">@project.Meta</p>
                    </div>
                    <a href="/projects" class="project-card__link"></a>
                </article>
            }
        </div>
    </div>
</section>
